generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["dataProxy"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  role     Role   @default(USER)
}

model RewardItem {
  id       Int    @id @default(autoincrement())
  name     String @unique
  cost     Int
  imageUrl String
  quantity Int    @default(0)
}

model Post {
  id          Int      @id @default(autoincrement())
  food        String
  quantity    Int
  bestDate    String
  image       String
  location    String
  description String
  owner       String
  createdAt   DateTime @default(now())
  ownerName   String
}

model Feedback {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  message   String
  createdAt DateTime @default(now())
}

enum Role {
  USER
  ADMIN
}
